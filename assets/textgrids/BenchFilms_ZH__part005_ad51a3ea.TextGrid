                text = ""
            intervals [2]:
                xmin = 72.076000
                xmax = 79.390000
                text = "纪女士说，经人介绍，三月十三号，她来到了杭州临平区秋山大街上的吴耀美门店，付了三千块钱祛痘。"
            intervals [3]:
                xmin = 79.390000
                xmax = 102.399000
                text = ""
            intervals [4]:
                xmin = 102.399000
                xmax = 107.100000
                text = "纪女士提供了做完项目后的照片，脸颊处都是密密麻麻的褐色斑点。"
            intervals [5]:
                xmin = 107.100000
                xmax = 107.420000
                text = ""
            intervals [6]:
                xmin = 107.420000
                xmax = 112.260000
                text = "纪女士说，店里告诉她十天左右会掉痂，这期间脸部不能碰水。"
            intervals [7]:
                xmin = 112.260000
                xmax = 112.730000
                text = ""
            intervals [8]:
                xmin = 112.730000
                xmax = 116.330000
                text = "她照做了，没什么异样，就是结痂时有些发痒。"
            intervals [9]:
                xmin = 116.330000
                xmax = 116.610000
                text = ""
            intervals [10]:
                xmin = 116.610000
                xmax = 118.330000
                text = "十天过后，她回到了店里。"
            intervals [11]:
                xmin = 118.330000
                xmax = 139.313000
                text = ""
            intervals [12]:
                xmin = 139.313000
                xmax = 140.293000
                text = "舒元那那瓶吗？"
            intervals [13]:
                xmin = 140.293000
                xmax = 149.798000
                text = ""
            intervals [14]:
                xmin = 149.798000
                xmax = 153.466000
                text = "金女士带来了一瓶产品，叫舒云草本调肤液。"
            intervals [15]:
                xmin = 153.466000
                xmax = 153.940000
                text = ""
            intervals [16]:
                xmin = 153.940000
                xmax = 158.212000
                text = "她说当时从店里带回了很多小瓶的产品，都没有包装盒。"
            intervals [17]:
                xmin = 158.212000
                xmax = 158.928000
                text = ""
            intervals [18]:
                xmin = 158.928000
                xmax = 164.880000
                text = "三月二十六号，纪女士给店老板发了一张皮肤状态的照片，可以看到有明显的泛红。"
            intervals [19]:
                xmin = 164.880000
                xmax = 165.680000
                text = ""
            intervals [20]:
                xmin = 165.680000
                xmax = 170.440000
                text = "老板发语音消息让金女士把产品带到店里，他再教一遍。"
            intervals [21]:
                xmin = 170.440000
                xmax = 171.179000
                text = ""
            intervals [22]:
                xmin = 171.179000
                xmax = 175.440000
                text = "还提到刷的话有点红或者刺痛都是正常的。"
            intervals [23]:
                xmin = 175.440000
                xmax = 192.378000
                text = ""
            intervals [24]:
                xmin = 192.378000
                xmax = 194.062000
                text = "纪女士受不了，去了医院。"
            intervals [25]:
                xmin = 194.062000
                xmax = 194.510000
                text = ""
            intervals [26]:
                xmin = 194.510000
                xmax = 197.568000
                text = "三月三十号的诊断记录是接触性皮炎。"
            intervals [27]:
                xmin = 197.568000
                xmax = 197.870000
                text = ""
            intervals [28]:
                xmin = 197.870000
                xmax = 202.630000
                text = "她说治疗花了三百多块钱，因为还在哺乳期，只用了外敷的药。"
            intervals [29]:
                xmin = 202.630000
                xmax = 203.328000
