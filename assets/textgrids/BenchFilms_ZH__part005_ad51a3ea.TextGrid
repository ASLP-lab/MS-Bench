            intervals [30]:
                xmin = 203.328000
                xmax = 206.728000
                text = "后来店里说是可以全额退款并赔偿医药费。"
            intervals [31]:
                xmin = 206.728000
                xmax = 254.380000
                text = ""
            intervals [32]:
                xmin = 254.380000
                xmax = 264.860000
                text = "蔡老板提供了一份 VIP 客户信息档案表，上面写着三月十三号的消费项目，包括冻干粉、小金瓶、礼芙霜等等，还有手写的一行文字。"
            intervals [33]:
                xmin = 264.860000
