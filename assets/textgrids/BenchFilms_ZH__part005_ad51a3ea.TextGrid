    item [5]:
        class = "IntervalTier"
        name = "spk_05"
        xmin = 0.000000
        xmax = 358.260000
        intervals: size = 47
            intervals [1]:
                xmin = 0.000000
                xmax = 49.531000
                text = ""
            intervals [2]:
                xmin = 49.531000
                xmax = 58.460000
                text = "脸上有一点点斑嘛，然后呃因为生小孩嘛，然后小孩生完以后，脸上那个色素好像加重了一点。"
            intervals [3]:
                xmin = 58.460000
                xmax = 58.820000
                text = ""
            intervals [4]:
                xmin = 58.820000
                xmax = 66.110000
                text = "然后我想着嘛嗯，小孩已经，现在已经大了一点了嘛，然后我想着考虑就先把这个斑去掉。"
            intervals [5]:
                xmin = 66.110000
                xmax = 66.350000
                text = ""
            intervals [6]:
                xmin = 66.350000
                xmax = 71.838000
                text = "我也，医院呢我也去过，医院说是慢慢退，然后我就想着尽快把它弄掉嘛。"
            intervals [7]:
                xmin = 71.838000
                xmax = 79.491000
                text = ""
            intervals [8]:
                xmin = 79.491000
                xmax = 81.159000
                text = "呃，我保证帮你搞好。"
            intervals [9]:
                xmin = 81.159000
                xmax = 82.316000
                text = ""
            intervals [10]:
                xmin = 82.316000
                xmax = 87.765000
                text = "呃，就包括产品加一次提取，手法提取。"
            intervals [11]:
                xmin = 87.765000
                xmax = 91.445000
                text = "应该就是他手操作，蘸个棉签，嗯，点在上面的。"
            intervals [12]:
                xmin = 91.445000
                xmax = 92.349000
                text = ""
            intervals [13]:
                xmin = 92.349000
                xmax = 95.871000
                text = "不不是药，药膏就是他们美容院里面的一种产品吧。"
            intervals [14]:
                xmin = 95.871000
                xmax = 100.861000
                text = "然后有点火辣辣的感觉，然后第二天就，反正就也"
            intervals [15]:
                xmin = 100.861000
                xmax = 101.260000
                text = ""
            intervals [16]:
                xmin = 101.260000
                xmax = 102.348000
                text = "状况差不多吧。"
            intervals [17]:
                xmin = 102.348000
                xmax = 118.469000
                text = ""
            intervals [18]:
                xmin = 118.469000
                xmax = 124.666000
                text = "痂不是没掉玩吗，她就给我弄弄了一个面膜给我敷上去，然后她把面膜揭掉以后啊，她就直接。"
            intervals [19]:
                xmin = 124.666000
                xmax = 124.966000
                text = ""
            intervals [20]:
                xmin = 124.966000
                xmax = 129.686000
                text = "拿一个镊子夹子把我皮肤全都夹夹，那个没掉痂的地方全夹掉了。"
            intervals [21]:
                xmin = 129.686000
                xmax = 132.340000
                text = "去完之后给我，给了一瓶那东西，什么液？"
            intervals [22]:
                xmin = 132.340000
                xmax = 133.060000
                text = ""
            intervals [23]:
                xmin = 133.060000
                xmax = 134.724000
                text = "他让我视频跟他。"
            intervals [24]:
                xmin = 134.724000
                xmax = 135.316000
                text = ""
            intervals [25]:
                xmin = 135.316000
                xmax = 139.180000
                text = "她手手把手教我，拿一个棉签蘸着，这样这样这样刷上去。"
            intervals [26]:
                xmin = 139.180000
                xmax = 140.229000
                text = ""
            intervals [27]:
                xmin = 140.229000
                xmax = 142.037000
                text = "啊对，就这样这样刷上去。"
            intervals [28]:
                xmin = 142.037000
                xmax = 142.869000
                text = ""
            intervals [29]:
                xmin = 142.869000
                xmax = 149.725000
                text = "刷上去当时我就脸就不行了，脸就好痛好痛好痛好疼啊，真的是那种刺痛，钻心的刺痛。"
            intervals [30]:
                xmin = 149.725000
                xmax = 175.740000
                text = ""
            intervals [31]:
                xmin = 175.740000
                xmax = 178.116000
                text = "嗯，一直强调是正常现象，那我就忍了呗。"
            intervals [32]:
                xmin = 178.116000
                xmax = 186.088000
                text = "第二天，第二，他他说你实在是，他叫我补救的方法就是涂了东一一支的那东西，在家又涂了一下，涂了一下又不行。"
            intervals [33]:
                xmin = 186.088000
                xmax = 186.100000
                text = ""
            intervals [34]:
                xmin = 186.100000
                xmax = 192.384000
                text = "然后后面我又来了一次，来了一次又给我敷同样的方法，就是和换各种各样的产品给我抹，就好像当我小白鼠一样。"
            intervals [35]:
                xmin = 192.384000
                xmax = 206.750000
                text = ""
            intervals [36]:
                xmin = 206.750000
                xmax = 214.178000
                text = "不接受啊，我脸红肿胀痛刺痛，我还没好，我怎么知道我脸是是怎么样子，能不能治得好，或者是怎么样，对不对？"
            intervals [37]:
                xmin = 214.178000
                xmax = 214.252000
                text = ""
            intervals [38]:
                xmin = 214.252000
                xmax = 217.242000
                text = "那我肯定，我的诉求肯定是呃退一赔三。"
            intervals [39]:
                xmin = 217.242000
                xmax = 218.699000
                text = ""
            intervals [40]:
                xmin = 218.699000
                xmax = 222.041000
                text = "因为他他这种产品，我还不知道是不是三无产品，对不对？"
            intervals [41]:
                xmin = 222.041000
                xmax = 222.170000
                text = ""
            intervals [42]:
                xmin = 222.170000
                xmax = 224.165000
                text = "我的小孩现在突然无缘无故的。"
            intervals [43]:
                xmin = 224.165000
                xmax = 224.380000
                text = ""
            intervals [44]:
                xmin = 224.380000
                xmax = 239.210000
                text = "高烧不退，那我是不是因为已经这个这个药已经这个东西已经吸到我皮肤里面，导致我母乳是，母母母乳喂给小孩，是不是他是不是这个药，他涂的这个东西产生的，我们也不知道。"
            intervals [45]:
                xmin = 239.210000
                xmax = 342.176000
                text = ""
            intervals [46]:
                xmin = 342.176000
                xmax = 342.817000
                text = "司法程序。"
            intervals [47]:
                xmin = 342.817000
                xmax = 358.260000
                text = ""
    item [6]:
        class = "IntervalTier"
        name = "spk_06"
