            text = ""
        intervals [86]:
            xmin = 593.694
            xmax = 600.984
            text = "直接忘本，还认识我们吗？到时候说哎呀，谁认识他们呀，那么穷，我都不想跟他们说话，就跟你那网红大咖一般。"
