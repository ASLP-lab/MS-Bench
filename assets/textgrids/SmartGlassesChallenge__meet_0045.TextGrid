            text = ""
        intervals [32]:
            xmin = 223.25400000000002
            xmax = 226.50400000000002
            text = "对呀，就是厉害，就是比你们厉害啊。"
        intervals [33]:
            xmin = 226.50400000000002
            xmax = 229.364
            text = ""
        intervals [34]:
            xmin = 229.364
            xmax = 233.524
            text = "看不上你知道吗？你这个学历太低了，你进不了我的公司。"
        intervals [35]:
            xmin = 233.524
            xmax = 235.144
            text = ""
        intervals [36]:
            xmin = 235.144
            xmax = 239.744
            text = "你的工，你这啥都不会，你们啥都不会，你们我的公司你们进不去啊。"
        intervals [37]:
            xmin = 239.744
            xmax = 241.084
            text = ""
        intervals [38]:
            xmin = 241.084
            xmax = 244.25400000000002
            text = "体制内你就干你的体制内呀，要不了你。"
        intervals [39]:
            xmin = 244.25400000000002
            xmax = 302.874
            text = ""
        intervals [40]:
            xmin = 302.874
            xmax = 305.30400000000003
            text = "就你自私，就你最自私，我看出来了。"
        intervals [41]:
            xmin = 305.30400000000003
            xmax = 308.914
            text = ""
        intervals [42]:
            xmin = 308.914
            xmax = 311.334
            text = "哎呀，反正呢我是支持这个海岛。"
        intervals [43]:
            xmin = 311.334
            xmax = 311.394
            text = ""
        intervals [44]:
            xmin = 311.394
            xmax = 313.874
            text = "高端局的，我跟你讲，肯定好玩。"
        intervals [45]:
            xmin = 313.874
            xmax = 313.974
            text = ""
        intervals [46]:
            xmin = 313.974
            xmax = 317.344
            text = "上次呢我团建还租过同类型的别墅呢。"
        intervals [47]:
            xmin = 317.344
            xmax = 317.604
            text = ""
        intervals [48]:
            xmin = 317.604
            xmax = 321.104
            text = "嗯~~，单日租金我感觉也就四千吧吧。"
        intervals [49]:
            xmin = 321.104
            xmax = 321.224
            text = ""
        intervals [50]:
            xmin = 321.224
            xmax = 324.774
            text = "嗯，旺季上浮百分之二十，杂费另算。"
        intervals [51]:
            xmin = 324.774
            xmax = 325.324
            text = ""
        intervals [52]:
            xmin = 325.324
            xmax = 328.344
            text = "你们自己谈一谈，我觉得完全能够接受呀。"
        intervals [53]:
            xmin = 328.344
            xmax = 330.594
            text = ""
        intervals [54]:
            xmin = 330.594
            xmax = 333.444
            text = "好好，我这点钱都出不起。"
        intervals [55]:
            xmin = 333.444
            xmax = 338.344
            text = ""
        intervals [56]:
            xmin = 338.344
            xmax = 344.284
            text = "哎，这么点钱都出不起，往自己身上好好想想，是不是自己不够努力啊？"
        intervals [57]:
            xmin = 344.284
            xmax = 390.724
            text = ""
        intervals [58]:
            xmin = 390.724
            xmax = 391.814
            text = "那要不。"
        intervals [59]:
            xmin = 391.814
            xmax = 391.884
            text = ""
        intervals [60]:
            xmin = 391.884
            xmax = 395.744
            text = "不富裕多承担点呗。哎呦，反正我随便，你定你定你定。"
        intervals [61]:
            xmin = 395.744
            xmax = 413.204
            text = ""
        intervals [62]:
            xmin = 413.204
            xmax = 415.974
            text = "其实就是要破产了，还听不清楚吗？"
        intervals [63]:
            xmin = 415.974
            xmax = 480.394
            text = ""
        intervals [64]:
            xmin = 480.394
            xmax = 483.404
            text = "我看你就是想当网红，想蹭流量。"
        intervals [65]:
            xmin = 483.404
