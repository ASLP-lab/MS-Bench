            text = ""
        intervals [68]:
            xmin = 485.504
            xmax = 488.724
            text = "当了网红之后还知道我们，直接忘本我看。"
        intervals [69]:
            xmin = 488.724
            xmax = 491.444
            text = ""
        intervals [70]:
            xmin = 491.444
            xmax = 496.36400000000003
            text = "我看你就有私心的，其实。你自己那个抖音号，你自己那我看不出来吗？"
        intervals [71]:
            xmin = 496.36400000000003
            xmax = 511.73400000000004
            text = ""
        intervals [72]:
            xmin = 511.73400000000004
            xmax = 515.104
            text = "她自己非要早结婚，关我啥事啊？她不是不结婚吗？"
        intervals [73]:
            xmin = 515.104
