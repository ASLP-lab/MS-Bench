            text = ""
        intervals [84]:
            xmin = 586.4540000000001
            xmax = 593.634
            text = "那个别人就给你点个几个点赞，还都是我们给你点赞的，好意思吗？想现在趁机拍vlog让你大火，然后变成大网红。"
        intervals [85]:
            xmin = 593.634
