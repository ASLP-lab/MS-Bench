            xmin = 664.114406307
            xmax = 676.089853983
            text = ""
        intervals [116]:
            xmin = 676.089853983
            xmax = 677.725045957
            text = "The speech impediment, yes."
        intervals [117]:
            xmin = 677.725045957
            xmax = 706.930295246
            text = ""
        intervals [118]:
            xmin = 706.930295246
            xmax = 712.955160898
            text = "I agree. I don't understand what she sees in him other than he is a boy who's her age."
        intervals [119]:
            xmin = 712.955160898
            xmax = 713.670592575
            text = ""
        intervals [120]:
            xmin = 713.670592575
            xmax = 720.894729443
            text = "And she is very boy crazy, which might explain why she's fixated on on him."
        intervals [121]:
            xmin = 720.894729443
            xmax = 722.071325269
            text = ""
        intervals [122]:
            xmin = 722.071325269
            xmax = 724.461301744
            text = "Because all the other boys in the class are."
        intervals [123]:
            xmin = 724.461301744
