            text = ""
        intervals [144]:
            xmin = 842.19801908
            xmax = 845.785024577
            text = "Um, yeah, that's very true."
        intervals [145]:
            xmin = 845.785024577
            xmax = 850.526539506
            text = "And then there's um the health inspectors, Hugo and."
        intervals [146]:
            xmin = 850.526539506
            xmax = 851.021869147
            text = ""
        intervals [147]:
            xmin = 851.021869147
            xmax = 857.362599668
            text = "Ron, that's it, and Hug- Hugo used to be engaged to Linda."
        intervals [148]:
            xmin = 857.362599668
            xmax = 860.896836514
            text = ""
        intervals [149]:
            xmin = 860.896836514
            xmax = 863.901099254
            text = "Yeah, something like that. And then she broke up with him."
