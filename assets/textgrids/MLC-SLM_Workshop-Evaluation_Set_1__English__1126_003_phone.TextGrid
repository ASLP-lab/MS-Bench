            text = ""
        intervals [124]:
            xmin = 726.664634326
            xmax = 727.681818179
            text = "Questionable."
        intervals [125]:
            xmin = 727.681818179
            xmax = 767.843181475
            text = ""
        intervals [126]:
            xmin = 767.843181475
            xmax = 772.47790974
            text = "Zeke is, he he does, his heart is in the right place."
        intervals [127]:
            xmin = 772.47790974
            xmax = 772.769843413
            text = ""
        intervals [128]:
            xmin = 772.769843413
            xmax = 779.604025798
            text = "That episode where he um he gets into trouble at school, just because he wants to make his grandmother happy."
        intervals [129]:
            xmin = 779.604025798
            xmax = 780.353027462
            text = ""
        intervals [130]:
            xmin = 780.353027462
            xmax = 781.240698588
            text = "That was sweet."
        intervals [131]:
            xmin = 781.240698588
            xmax = 787.907082819
            text = ""
        intervals [132]:
            xmin = 787.907082819
            xmax = 793.967357806
            text = "Yeah, and um and Jimmy Pesto is in his own world, where he thinks he's fantastic and."
        intervals [133]:
            xmin = 793.967357806
            xmax = 795.146911132
            text = ""
        intervals [134]:
            xmin = 795.146911132
            xmax = 798.402505164
            text = "And and he's actually not interested in romance, really."
        intervals [135]:
            xmin = 798.402505164
