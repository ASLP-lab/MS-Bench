            xmax = 1082.193519118
            text = ""
        intervals [304]:
            xmin = 1082.193519118
            xmax = 1085.96836695
            text = "Cuz it would go very smooth at some points, um which is pretty impressive."
        intervals [305]:
            xmin = 1085.96836695
