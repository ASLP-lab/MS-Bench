            xmin = 1038.029337105
            xmax = 1040.673301869
            text = ""
        intervals [294]:
            xmin = 1040.673301869
            xmax = 1047.852182129
            text = "Yeah. Um, they did that with, um, Kimetsu no Yaiba, which is Demon Slayer. It's an anime. Um."
