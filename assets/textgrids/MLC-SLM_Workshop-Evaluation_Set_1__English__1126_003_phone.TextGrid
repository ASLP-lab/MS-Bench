            text = ""
        intervals [312]:
            xmin = 1119.097043653
            xmax = 1119.767375366
            text = "Here we go."
        intervals [313]:
            xmin = 1119.767375366
            xmax = 1125.696641587
            text = ""
        intervals [314]:
            xmin = 1125.696641587
            xmax = 1132.936377611
            text = "Spider-Verse has arguably been one of the best movie series I've ever watched in my entire life. I'm not even kidding. Um."
        intervals [315]:
            xmin = 1132.936377611
            xmax = 1135.786223463
            text = ""
        intervals [316]:
            xmin = 1135.786223463
            xmax = 1143.341893667
            text = "Yes, it was the animation first off was very unique and they actually say we're in the golden age of animation right now because of that."
        intervals [317]:
            xmin = 1143.341893667
            xmax = 1144.214565595
            text = ""
        intervals [318]:
            xmin = 1144.214565595
            xmax = 1151.86962193
            text = "Yeah, because um Spider-Verse was able to compile two D and three D at the same time, um if that makes sense."
        intervals [319]:
            xmin = 1151.86962193
            xmax = 1153.871385532
            text = ""
        intervals [320]:
            xmin = 1153.871385532
            xmax = 1159.839335327
            text = "And yes, a lot of animation, a lot of more anime anime movies now have kind of taken after that."
        intervals [321]:
            xmin = 1159.839335327
            xmax = 1159.990174776
            text = ""
        intervals [322]:
            xmin = 1159.990174776
            xmax = 1164.449675518
            text = "Um and animation now is like looking a lot more prettier than it did before when it compared to."
        intervals [323]:
            xmin = 1164.449675518
            xmax = 1164.503304296
            text = ""
        intervals [324]:
            xmin = 1164.503304296
            xmax = 1168.844913908
            text = "If you compare Encanto to, um I don't know, Wild Robot, for examp-."
        intervals [325]:
            xmin = 1168.844913908
            xmax = 1169.10965403
            text = ""
        intervals [326]:
            xmin = 1169.10965403
            xmax = 1175.12541399
            text = "You would notice a huge difference in the animation and generally in my opinion it's a lot more aesthetically pleasing. Um."
        intervals [327]:
            xmin = 1175.12541399
            xmax = 1179.600134871
            text = ""
        intervals [328]:
            xmin = 1179.600134871
            xmax = 1181.361865967
            text = "Uh the opposite, actually, I think."
        intervals [329]:
            xmin = 1181.361865967
            xmax = 1181.95938161
            text = ""
        intervals [330]:
            xmin = 1181.95938161
            xmax = 1186.487774243
            text = "It's because of this sort of, it's got a, it is realistic, I suppose."
        intervals [331]:
            xmin = 1186.487774243
            xmax = 1186.872082754
            text = ""
        intervals [332]:
            xmin = 1186.872082754
            xmax = 1193.422518185
            text = "But it's got this certain fantastical edge to it that kind of makes you forget about real life, if that makes sense."
        intervals [333]:
            xmin = 1193.422518185
            xmax = 1193.474480691
            text = ""
        intervals [334]:
            xmin = 1193.474480691
            xmax = 1200.662191358
