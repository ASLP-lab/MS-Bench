            text = ""
        intervals [290]:
            xmin = 1022.810484358
            xmax = 1029.978064068
            text = "Like, I think apart from the South Park movie, um all other movies, including animation, haven't done so well."
        intervals [291]:
            xmin = 1029.978064068
            xmax = 1031.237951443
            text = ""
        intervals [292]:
            xmin = 1031.237951443
            xmax = 1038.029337105
            text = "I think so, yeah. I think they might have just compiled a bunch of episodes, and then just called it a movie cause some people do that."
