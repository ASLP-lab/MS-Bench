            xmin = 804.638194915
            xmax = 815.74503224
            text = ""
        intervals [140]:
            xmin = 815.74503224
            xmax = 817.47366584
            text = "That's one of your pet peeves, isn't it?"
        intervals [141]:
            xmin = 817.47366584
