            xmin = 1657.109639915
            xmax = 1657.128730036
            text = ""
        intervals [456]:
            xmin = 1657.128730036
            xmax = 1660.341297224
            text = "So the magic was still necessary, so that's fine with me."
        intervals [457]:
            xmin = 1660.341297224
            xmax = 1660.461403051
            text = ""
        intervals [458]:
            xmin = 1660.461403051
            xmax = 1668.450668072
            text = "Um but yeah, when it comes to um it being the first thing of its kind."
        intervals [459]:
            xmin = 1668.450668072
            xmax = 1668.544371762
            text = ""
        intervals [460]:
            xmin = 1668.544371762
            xmax = 1672.338571832
            text = "Um obviously, it would blow up a lot more quickly because no one's ever seen this before."
        intervals [461]:
            xmin = 1672.338571832
            xmax = 1672.359513649
            text = ""
        intervals [462]:
            xmin = 1672.359513649
            xmax = 1675.196994707
            text = "So, you know, everyone's gonna be like, oh, this is amazing."
        intervals [463]:
            xmin = 1675.196994707
            xmax = 1678.927236756
            text = ""
        intervals [464]:
            xmin = 1678.927236756
            xmax = 1686.052454555
            text = "I mean, as soon as Star Wars ended, a lot of people just got in line to watch it again, which has been, in my opinion, a bit too much, but go ahead."
        intervals [465]:
            xmin = 1686.052454555
            xmax = 1687.284282169
            text = ""
        intervals [466]:
            xmin = 1687.284282169
            xmax = 1690.131386874
            text = "Star Trek too. The Star Trek is pretty popular."
        intervals [467]:
            xmin = 1690.131386874
            xmax = 1694.057244047
            text = ""
        intervals [468]:
            xmin = 1694.057244047
            xmax = 1695.427056562
            text = "I know nothing about it. Um."
        intervals [469]:
            xmin = 1695.427056562
            xmax = 1702.320167241
            text = ""
        intervals [470]:
            xmin = 1702.320167241
            xmax = 1705.764081993
            text = "We seem to gravitate towards fantasy more than sky-fi sci-fi."
        intervals [471]:
            xmin = 1705.764081993
            xmax = 1723.800108855
            text = ""
        intervals [472]:
            xmin = 1723.800108855
            xmax = 1730.132778635
            text = "So you just try to think of them and they all leave your brain. Um, oh, Miss Peregrine's Home for Peculiar Children."
        intervals [473]:
            xmin = 1730.132778635
            xmax = 1732.741789449
            text = ""
        intervals [474]:
            xmin = 1732.741789449
            xmax = 1736.242822697
            text = "Lovely movie, um very good visual visuals."
        intervals [475]:
            xmin = 1736.242822697
            xmax = 1736.548132193
            text = ""
        intervals [476]:
            xmin = 1736.548132193
            xmax = 1744.476201341
            text = "I love the idea of um a a place where, I don't know, it's it's like a time loop."
        intervals [477]:
            xmin = 1744.476201341
            xmax = 1744.657904307
            text = ""
        intervals [478]:
            xmin = 1744.657904307
            xmax = 1752.605188761
            text = "You know, the idea of someone entering this world where they have to live the same day every single day and like, you know, or do the exact same things and stuff like that."
        intervals [479]:
            xmin = 1752.605188761
            xmax = 1752.756630594
            text = ""
        intervals [480]:
            xmin = 1752.756630594
            xmax = 1756.177041529
            text = "That sounds maddening. I would never be able to do that. Um."
