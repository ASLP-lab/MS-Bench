            xmin = 1756.177041529
            xmax = 1756.766008399
            text = ""
        intervals [482]:
            xmin = 1756.766008399
            xmax = 1763.982367887
            text = "It's almost something like it's re- it's reminiscent of Alice in Wonderland a little bit, um which is definitely one of my favorite movies."
        intervals [483]:
            xmin = 1763.982367887
            xmax = 1764.11299309
            text = ""
        intervals [484]:
            xmin = 1764.11299309
            xmax = 1766.950115857
            text = "Um but yeah it's, it was a very good movie."
        intervals [485]:
            xmin = 1766.950115857
            xmax = 1766.984540315
            text = ""
        intervals [486]:
            xmin = 1766.984540315
            xmax = 1774.179861052
            text = "It's it it combined fantasy and um eeriness very well, which is pretty hard to do."
