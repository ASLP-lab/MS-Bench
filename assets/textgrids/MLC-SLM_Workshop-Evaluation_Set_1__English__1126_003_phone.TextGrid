            xmin = 22.826135298
            xmax = 23.925793245
            text = "A lot."
        intervals [3]:
            xmin = 23.925793245
            xmax = 40.082800949
            text = ""
        intervals [4]:
            xmin = 40.082800949
            xmax = 41.114472475
            text = "Animated."
        intervals [5]:
            xmin = 41.114472475
            xmax = 49.657315975
            text = ""
        intervals [6]:
            xmin = 49.657315975
            xmax = 51.32947362
            text = "What would you say is your favorite?"
        intervals [7]:
            xmin = 51.32947362
            xmax = 94.342522686
            text = ""
        intervals [8]:
            xmin = 94.342522686
            xmax = 101.721552934
            text = "Yeah. And the good thing about animation, I think, is that you can obviously you can do a lot more."
        intervals [9]:
            xmin = 101.721552934
            xmax = 101.856234285
            text = ""
        intervals [10]:
            xmin = 101.856234285
            xmax = 103.590488905
            text = "In terms of effects."
        intervals [11]:
            xmin = 103.590488905
            xmax = 104.557903277
            text = ""
        intervals [12]:
            xmin = 104.557903277
            xmax = 105.4680524
            text = "Yeah."
        intervals [13]:
            xmin = 105.4680524
            xmax = 112.175428776
            text = ""
        intervals [14]:
            xmin = 112.175428776
            xmax = 119.37583611
            text = "Um and we can't talk about animation without mentioning Bob's Burgers."
        intervals [15]:
            xmin = 119.37583611
            xmax = 121.789361576
            text = ""
        intervals [16]:
            xmin = 121.789361576
            xmax = 123.935711748
            text = "Best show ever, number one."
        intervals [17]:
            xmin = 123.935711748
            xmax = 125.670552614
            text = ""
        intervals [18]:
            xmin = 125.670552614
            xmax = 127.083980968
            text = "On both our lists."
        intervals [19]:
            xmin = 127.083980968
            xmax = 159.730141117
            text = ""
        intervals [20]:
            xmin = 159.730141117
            xmax = 160.883939531
            text = "Is Meg the daughter?"
        intervals [21]:
            xmin = 160.883939531
            xmax = 162.182638995
            text = ""
        intervals [22]:
            xmin = 162.182638995
            xmax = 162.924538823
            text = "Oh right, okay."
        intervals [23]:
            xmin = 162.924538823
            xmax = 169.429134995
            text = ""
        intervals [24]:
            xmin = 169.429134995
            xmax = 170.642080914
            text = "Is she annoying?"
        intervals [25]:
            xmin = 170.642080914
            xmax = 173.70834894
            text = ""
        intervals [26]:
            xmin = 173.70834894
            xmax = 174.73470169
            text = "So it's just a."
        intervals [27]:
            xmin = 174.73470169
            xmax = 175.532991866
            text = ""
        intervals [28]:
            xmin = 175.532991866
            xmax = 176.45171756
            text = "Right, it's a gag."
        intervals [29]:
            xmin = 176.45171756
            xmax = 181.561723808
            text = ""
        intervals [30]:
            xmin = 181.561723808
            xmax = 183.399175196
            text = "Oh , South Park, yes."
        intervals [31]:
            xmin = 183.399175196
            xmax = 194.139629
            text = ""
        intervals [32]:
            xmin = 194.139629
            xmax = 195.629635922
            text = "No one is safe, that's for sure."
        intervals [33]:
            xmin = 195.629635922
            xmax = 218.174933816
            text = ""
        intervals [34]:
            xmin = 218.174933816
            xmax = 220.93879898
            text = "Yet it still reflects family life."
        intervals [35]:
            xmin = 220.93879898
            xmax = 238.978176224
            text = ""
        intervals [36]:
            xmin = 238.978176224
            xmax = 241.593604622
            text = "I think so. He's a lot more normal than Linda."
        intervals [37]:
            xmin = 241.593604622
            xmax = 275.517763216
            text = ""
        intervals [38]:
            xmin = 275.517763216
            xmax = 282.408836585
            text = "I think you could say moral because , you know. In the end she always comes around and does the right thing."
        intervals [39]:
            xmin = 282.408836585
            xmax = 283.610759955
            text = ""
        intervals [40]:
            xmin = 283.610759955
            xmax = 286.528386741
            text = "Even though she's often the one who causes the trouble."
        intervals [41]:
            xmin = 286.528386741
            xmax = 308.396321681
            text = ""
        intervals [42]:
            xmin = 308.396321681
            xmax = 312.118531516
            text = "Yet she has enormous confidence and um."
        intervals [43]:
            xmin = 312.118531516
            xmax = 313.828650025
            text = ""
        intervals [44]:
            xmin = 313.828650025
            xmax = 319.591453073
            text = "Yeah, the confidence and and she takes charge of situations and she's al- always ready with a plan."
        intervals [45]:
            xmin = 319.591453073
            xmax = 356.271703141
            text = ""
        intervals [46]:
            xmin = 356.271703141
            xmax = 364.1318776
            text = "Yeah, they they would assume that she'd be an introvert, and withdrawn and and have some issues and phobias and things."
        intervals [47]:
            xmin = 364.1318776
            xmax = 364.161338567
            text = ""
        intervals [48]:
            xmin = 364.161338567
            xmax = 369.441569483
            text = "But it's it's it's an unspoken security blanket of sorts, isn't it?"
        intervals [49]:
            xmin = 369.441569483
            xmax = 379.229977569
            text = ""
        intervals [50]:
            xmin = 379.229977569
            xmax = 380.00912707
            text = "Definitely."
        intervals [51]:
            xmin = 380.00912707
            xmax = 382.551115829
            text = ""
        intervals [52]:
            xmin = 382.551115829
            xmax = 389.548673794
            text = "Um and then there's the other the s- the supporting characters too, which really make the show."
        intervals [53]:
            xmin = 389.548673794
            xmax = 389.663704928
            text = ""
        intervals [54]:
            xmin = 389.663704928
            xmax = 391.000429769
            text = "Like Teddy."
        intervals [55]:
            xmin = 391.000429769
            xmax = 394.233078423
            text = ""
        intervals [56]:
            xmin = 394.233078423
            xmax = 397.199789247
            text = "He's been inside um."
        intervals [57]:
            xmin = 397.199789247
            xmax = 416.445312818
            text = ""
        intervals [58]:
            xmin = 416.445312818
            xmax = 418.000970674
            text = "He was so threatened, wasn't he?"
        intervals [59]:
            xmin = 418.000970674
            xmax = 418.739026461
            text = ""
        intervals [60]:
            xmin = 418.739026461
            xmax = 419.720139214
            text = "So jealous."
        intervals [61]:
            xmin = 419.720139214
            xmax = 421.758967608
            text = ""
        intervals [62]:
            xmin = 421.758967608
            xmax = 428.329309256
            text = "And he's always trying to strengthen their friendship, instead of just letting it be like."
        intervals [63]:
            xmin = 428.329309256
            xmax = 429.61155461
            text = ""
        intervals [64]:
            xmin = 429.61155461
            xmax = 434.76227888
            text = "He doesn't he doesn't just allow the friendship to flow. He's he's gonna force it."
        intervals [65]:
            xmin = 434.76227888
            xmax = 436.554188027
            text = ""
        intervals [66]:
            xmin = 436.554188027
            xmax = 442.927021033
            text = "But it's kind of sweet too at the same time, because he would do anything for for Bob and Linda."
        intervals [67]:
            xmin = 442.927021033
            xmax = 451.060418535
            text = ""
        intervals [68]:
            xmin = 451.060418535
            xmax = 453.894056594
            text = "That's the other part of Bob's Burgers is the music."
        intervals [69]:
            xmin = 453.894056594
            xmax = 460.331658124
            text = ""
        intervals [70]:
            xmin = 460.331658124
            xmax = 464.820899093
            text = "It's really impressive, really impressive. Every single episode has a song."
        intervals [71]:
            xmin = 464.820899093
            xmax = 474.14979321
            text = ""
        intervals [72]:
            xmin = 474.14979321
            xmax = 480.906035077
            text = "And then of course there's the um the opening the opening scene with the with the new shop next door."
        intervals [73]:
            xmin = 480.906035077
            xmax = 483.11635232
            text = ""
        intervals [74]:
            xmin = 483.11635232
            xmax = 486.382608225
            text = "Burger of the day and then the the van, the exterminator van."
        intervals [75]:
            xmin = 486.382608225
            xmax = 486.704512438
            text = ""
        intervals [76]:
            xmin = 486.704512438
            xmax = 488.196586422
            text = "As a new company each time."
        intervals [77]:
            xmin = 488.196586422
            xmax = 495.735158911
            text = ""
        intervals [78]:
            xmin = 495.735158911
            xmax = 497.803252733
            text = "The Simpsons comes close."
        intervals [79]:
            xmin = 497.803252733
            xmax = 499.332399092
            text = ""
        intervals [80]:
            xmin = 499.332399092
            xmax = 501.638823429
            text = "It used to be my favourite."
        intervals [81]:
            xmin = 501.638823429
            xmax = 503.726629156
            text = ""
        intervals [82]:
            xmin = 503.726629156
            xmax = 505.254181914
            text = "Until Bob's came along."
        intervals [83]:
            xmin = 505.254181914
            xmax = 516.229219961
            text = ""
        intervals [84]:
            xmin = 516.229219961
            xmax = 517.114521782
            text = "That's true."
        intervals [85]:
            xmin = 517.114521782
            xmax = 554.341028478
            text = ""
        intervals [86]:
            xmin = 554.341028478
            xmax = 560.388290527
            text = "It it definitely um opened up almost a new genre."
        intervals [87]:
            xmin = 560.388290527
            xmax = 560.855041437
            text = ""
        intervals [88]:
            xmin = 560.855041437
            xmax = 563.952764044
            text = "In animation, in that it had that family sort of."
        intervals [89]:
            xmin = 563.952764044
            xmax = 564.626792531
            text = ""
        intervals [90]:
            xmin = 564.626792531
            xmax = 569.654797586
            text = "Um set up and each week."
        intervals [91]:
            xmin = 569.654797586
            xmax = 570.457775244
            text = ""
        intervals [92]:
            xmin = 570.457775244
            xmax = 573.143865027
            text = "They don't age, they're always at the same age and everything."
        intervals [93]:
            xmin = 573.143865027
            xmax = 573.917252323
            text = ""
        intervals [94]:
            xmin = 573.917252323
            xmax = 577.39225283
            text = "Goes back to square one and then they start on a on a new story."
        intervals [95]:
            xmin = 577.39225283
            xmax = 578.588057768
            text = ""
        intervals [96]:
            xmin = 578.588057768
            xmax = 580.064459427
            text = "Yeah, it's really clever."
        intervals [97]:
            xmin = 580.064459427
            xmax = 580.935735245
            text = ""
        intervals [98]:
            xmin = 580.935735245
            xmax = 587.056922555
            text = "And um what are they up to now, thirty thirty-five seasons or something now?"
        intervals [99]:
            xmin = 587.056922555
            xmax = 587.957157109
            text = ""
        intervals [100]:
            xmin = 587.957157109
            xmax = 590.520249755
            text = "Wow. Yeah, that's amazing."
        intervals [101]:
            xmin = 590.520249755
            xmax = 616.853188928
            text = ""
        intervals [102]:
            xmin = 616.853188928
            xmax = 624.594192049
            text = "Yeah, I agree. It were the first seasons were almost like an indie or alternative type show."
        intervals [103]:
            xmin = 624.594192049
            xmax = 625.113073012
            text = ""
        intervals [104]:
            xmin = 625.113073012
            xmax = 631.324740316
            text = "Um with with uh with an edge, but it was a little bit too inaccessible for everyone."
        intervals [105]:
            xmin = 631.324740316
            xmax = 632.457416974
            text = ""
        intervals [106]:
            xmin = 632.457416974
            xmax = 636.724295917
            text = "Because um it was very risky and there was drug use and."
        intervals [107]:
            xmin = 636.724295917
            xmax = 640.166033608
            text = ""
        intervals [108]:
            xmin = 640.166033608
            xmax = 643.195723817
            text = "Yeah and then yeah then you never heard of him again."
        intervals [109]:
            xmin = 643.195723817
            xmax = 643.272101136
            text = ""
        intervals [110]:
            xmin = 643.272101136
            xmax = 648.98817729
            text = "But I think that where it is now, is is um just the natural place for it to be, I think."
        intervals [111]:
            xmin = 648.98817729
            xmax = 653.334016267
            text = ""
        intervals [112]:
            xmin = 653.334016267
            xmax = 653.895246189
            text = "Yeah."
