            text = ""
        intervals [136]:
            xmin = 799.598883309
            xmax = 801.174927778
            text = "But Tina keeps pushing it."
        intervals [137]:
            xmin = 801.174927778
            xmax = 803.617160941
            text = ""
        intervals [138]:
            xmin = 803.617160941
            xmax = 804.638194915
            text = "Yeah, definitely ."
