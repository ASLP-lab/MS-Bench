            xmin = 1233.938528342
            xmax = 1241.919531658
            text = ""
        intervals [346]:
            xmin = 1241.919531658
            xmax = 1242.602646458
            text = "I suppose."
        intervals [347]:
            xmin = 1242.602646458
            xmax = 1242.97964923
            text = ""
        intervals [348]:
            xmin = 1242.97964923
            xmax = 1249.341889474
            text = "Um, yes, but certain, yes, there's, like, mythology and, um."
        intervals [349]:
            xmin = 1249.341889474
            xmax = 1249.951178513
            text = ""
        intervals [350]:
            xmin = 1249.951178513
            xmax = 1254.224590843
            text = "They are really old m- um religions, like Greek mythology, for example, that's obviously not true."
        intervals [351]:
            xmin = 1254.224590843
            xmax = 1254.758370584
            text = ""
        intervals [352]:
            xmin = 1254.758370584
            xmax = 1259.969960229
            text = "Um but yeah, it's very fascinating to think about and speculate."
        intervals [353]:
            xmin = 1259.969960229
            xmax = 1278.886707965
            text = ""
        intervals [354]:
            xmin = 1278.886707965
            xmax = 1280.918744137
            text = "Incredible. Even better, I would argue."
        intervals [355]:
            xmin = 1280.918744137
            xmax = 1287.738108957
            text = ""
        intervals [356]:
            xmin = 1287.738108957
            xmax = 1294.211547963
            text = "Yes, um I think the thing is that they planned out the entire Spider-Verse movie from the beginning."
        intervals [357]:
            xmin = 1294.211547963
            xmax = 1294.46200268
            text = ""
        intervals [358]:
            xmin = 1294.46200268
            xmax = 1300.22639724
            text = "So when they made the first Spider-Verse thing, they already planned across the Spider-Verse and beyond the Spider-Verse."
        intervals [359]:
            xmin = 1300.22639724
            xmax = 1301.395492602
            text = ""
        intervals [360]:
            xmin = 1301.395492602
            xmax = 1307.030749086
            text = "The across the Spider-Verse was originally gonna be the end, um because it was gonna be a four-hour movie. They were like, we better split."
        intervals [361]:
            xmin = 1307.030749086
            xmax = 1307.048466279
            text = ""
        intervals [362]:
            xmin = 1307.048466279
            xmax = 1309.727210752
            text = "This is gonna be a long time to watch um."
        intervals [363]:
            xmin = 1309.727210752
            xmax = 1310.934882912
            text = ""
        intervals [364]:
            xmin = 1310.934882912
            xmax = 1311.459977709
            text = "Yeah."
        intervals [365]:
            xmin = 1311.459977709
            xmax = 1322.939008032
            text = ""
        intervals [366]:
            xmin = 1322.939008032
            xmax = 1323.577537289
            text = "Yeah."
        intervals [367]:
            xmin = 1323.577537289
            xmax = 1340.244843572
            text = ""
        intervals [368]:
            xmin = 1340.244843572
            xmax = 1341.016778415
            text = "Marvelous."
        intervals [369]:
            xmin = 1341.016778415
            xmax = 1346.436943112
            text = ""
        intervals [370]:
            xmin = 1346.436943112
            xmax = 1347.7741656
            text = "Stanley's a legend."
        intervals [371]:
            xmin = 1347.7741656
            xmax = 1364.396696207
            text = ""
        intervals [372]:
            xmin = 1364.396696207
            xmax = 1369.759244208
            text = "Oh, yeah, I I have a lot of opinions on Harry Potter. Um."
        intervals [373]:
            xmin = 1369.759244208
            xmax = 1370.103847086
            text = ""
        intervals [374]:
            xmin = 1370.103847086
            xmax = 1376.67347585
            text = "Very, very good idea for a story first off about an orphan who goes to a magical school. That's very cool um."
        intervals [375]:
            xmin = 1376.67347585
            xmax = 1377.329830221
            text = ""
        intervals [376]:
            xmin = 1377.329830221
            xmax = 1383.275128952
            text = "But I would argue that the execution, it's kind of deteriorated as it went along, almost."
        intervals [377]:
            xmin = 1383.275128952
            xmax = 1383.47151462
            text = ""
        intervals [378]:
            xmin = 1383.47151462
            xmax = 1389.986809009
            text = "I feel like the author sort of just J K Rowling at some points. She threw in everything she could think of."
        intervals [379]:
            xmin = 1389.986809009
            xmax = 1390.138483948
            text = ""
        intervals [380]:
            xmin = 1390.138483948
            xmax = 1396.116415681
            text = "Um, the third movie, we ran and get introduced to Sirius Black and the books too. We get introduced to Sirius Black."
        intervals [381]:
            xmin = 1396.116415681
            xmax = 1396.202634486
            text = ""
        intervals [382]:
            xmin = 1396.202634486
            xmax = 1400.855296273
            text = "And apparently and Harry doesn't know who the hell this is everyone else does though you know."
        intervals [383]:
            xmin = 1400.855296273
            xmax = 1401.143034762
            text = ""
        intervals [384]:
            xmin = 1401.143034762
            xmax = 1405.515155877
            text = "Hermione knows about it, Ron knows about it, there's been absolutely no reference, he doesn't even know his own godfather."
        intervals [385]:
            xmin = 1405.515155877
            xmax = 1405.959036963
            text = ""
        intervals [386]:
            xmin = 1405.959036963
            xmax = 1413.674458389
            text = "There's nothing um that comes back to that. And it's very confusing because you're thinking. If he was such a big deal, wouldn't he be known before this?"
        intervals [387]:
            xmin = 1413.674458389
            xmax = 1413.755553193
            text = ""
        intervals [388]:
            xmin = 1413.755553193
            xmax = 1418.587947342
            text = "Like, that would be incredible if it was obvious- if it was like, foreshadowed, when, like, someone said, you know um."
        intervals [389]:
            xmin = 1418.587947342
            xmax = 1418.652643919
            text = ""
        intervals [390]:
            xmin = 1418.652643919
            xmax = 1424.0360945
            text = "I don't know, this situation is almost bad as like, you know, that time where Sirius Black killed so many people with one spell."
        intervals [391]:
            xmin = 1424.0360945
            xmax = 1424.375291018
            text = ""
        intervals [392]:
            xmin = 1424.375291018
            xmax = 1429.207548995
            text = "And then, you know, everyone's like, oh, yeah, that's so true. And Harry Potter will be like, who's Sirius Black? And then they tell them something like."
        intervals [393]:
            xmin = 1429.207548995
            xmax = 1429.555240324
            text = ""
        intervals [394]:
            xmin = 1429.555240324
            xmax = 1434.193702886
            text = "And then, you know, it could have been forgotten until the third book, but they didn't do that."
        intervals [395]:
            xmin = 1434.193702886
            xmax = 1434.239363303
            text = ""
        intervals [396]:
            xmin = 1434.239363303
            xmax = 1438.040593031
            text = "They just just went along with it and it's it's a bit annoying."
        intervals [397]:
            xmin = 1438.040593031
            xmax = 1447.451877166
            text = ""
        intervals [398]:
            xmin = 1447.451877166
            xmax = 1451.254170783
            text = "Yes, it's very important to plan out the that's the reason."
        intervals [399]:
            xmin = 1451.254170783
            xmax = 1451.315051339
            text = ""
        intervals [400]:
            xmin = 1451.315051339
            xmax = 1456.104873522
            text = "Why, in my opinion, Marvel and Marvel surpasses that kind of thing."
        intervals [401]:
            xmin = 1456.104873522
            xmax = 1456.138581398
            text = ""
        intervals [402]:
            xmin = 1456.138581398
            xmax = 1461.115094378
            text = "Because the creators, they actually plan out everything before they do it."
        intervals [403]:
            xmin = 1461.115094378
            xmax = 1461.167594321
            text = ""
        intervals [404]:
            xmin = 1461.167594321
            xmax = 1467.963386408
            text = "And if there's gonna be a sequel, then they already know it before they make the first one. Um. So that's kind of why."
        intervals [405]:
            xmin = 1467.963386408
            xmax = 1468.000128775
            text = ""
        intervals [406]:
            xmin = 1468.000128775
            xmax = 1472.507840949
            text = "Cause I think J K Rowling didn't know it was gonna take off cause she went to a lot of authors."
        intervals [407]:
            xmin = 1472.507840949
            xmax = 1472.555830261
            text = ""
        intervals [408]:
            xmin = 1472.555830261
            xmax = 1478.006181128
            text = "I mean, a lot of publishers um about her book story that was eventually will be turned into a movie."
        intervals [409]:
            xmin = 1478.006181128
            xmax = 1478.162187553
            text = ""
        intervals [410]:
            xmin = 1478.162187553
            xmax = 1481.20692096
            text = "Um didn't really get that popular."
        intervals [411]:
            xmin = 1481.20692096
            xmax = 1481.235293701
            text = ""
        intervals [412]:
            xmin = 1481.235293701
            xmax = 1489.234415475
            text = "But I mean, until she found that one author, a publisher, they published it and then it wa- wa- was really popular and then got turned into a movie. Then she obviously had to make more."
        intervals [413]:
            xmin = 1489.234415475
            xmax = 1489.588706947
            text = ""
        intervals [414]:
            xmin = 1489.588706947
            xmax = 1493.039873477
            text = "Um but yeah, Marvel kind of just knows what it's doing all along so."
        intervals [415]:
            xmin = 1493.039873477
            xmax = 1509.240170411
            text = ""
        intervals [416]:
            xmin = 1509.240170411
            xmax = 1509.805329133
            text = "Yes."
        intervals [417]:
            xmin = 1509.805329133
            xmax = 1521.608199663
            text = ""
        intervals [418]:
            xmin = 1521.608199663
            xmax = 1523.203447932
            text = "Yeah, and they're just forgotten about."
        intervals [419]:
            xmin = 1523.203447932
            xmax = 1531.963544671
            text = ""
        intervals [420]:
            xmin = 1531.963544671
            xmax = 1533.400815911
            text = "I'm a proud hater."
        intervals [421]:
            xmin = 1533.400815911
            xmax = 1535.531359298
            text = ""
        intervals [422]:
            xmin = 1535.531359298
            xmax = 1540.676514869
            text = "Of Harry Potter. Everything in general, I think. I had a lot of things."
        intervals [423]:
            xmin = 1540.676514869
            xmax = 1549.203484301
            text = ""
        intervals [424]:
            xmin = 1549.203484301
            xmax = 1549.914033398
            text = "Very Sigma ."
        intervals [425]:
            xmin = 1549.914033398
            xmax = 1556.653107268
            text = ""
        intervals [426]:
            xmin = 1556.653107268
            xmax = 1557.814135159
            text = "Jack Sparrow?"
        intervals [427]:
            xmin = 1557.814135159
            xmax = 1561.876470308
            text = ""
        intervals [428]:
            xmin = 1561.876470308
            xmax = 1563.510306362
            text = "Johnny Depp nailed it."
        intervals [429]:
            xmin = 1563.510306362
            xmax = 1565.615741896
            text = ""
        intervals [430]:
            xmin = 1565.615741896
            xmax = 1571.717766346
            text = "He was like made to play Jack Sparrow. I think that was possibly his best acting he's ever done in his entire life."
        intervals [431]:
            xmin = 1571.717766346
            xmax = 1572.841863913
            text = ""
        intervals [432]:
            xmin = 1572.841863913
            xmax = 1573.913271404
            text = "Like, it's just ."
        intervals [433]:
            xmin = 1573.913271404
            xmax = 1575.278089811
            text = ""
        intervals [434]:
            xmin = 1575.278089811
            xmax = 1580.388251497
            text = "Exactly, like, just the character and stuff, it just, I don't know, he understood the assignment."
        intervals [435]:
            xmin = 1580.388251497
            xmax = 1580.421188829
            text = ""
        intervals [436]:
            xmin = 1580.421188829
            xmax = 1587.69498213
            text = "And it was, it definitely surpassed my expectations, because I've watched a few scenes of it. And I was, I was thinking just, wow."
        intervals [437]:
            xmin = 1587.69498213
            xmax = 1587.707597295
            text = ""
        intervals [438]:
            xmin = 1587.707597295
            xmax = 1594.483289333
            text = "That's, I can really tell who he is. You know, as as soon as he's introduced, you just know, oh, this guy's a bit special."
        intervals [439]:
            xmin = 1594.483289333
            xmax = 1595.130145243
            text = ""
        intervals [440]:
            xmin = 1595.130145243
            xmax = 1598.012570136
            text = "He can just tell us immediately as soon as he's sane."
        intervals [441]:
            xmin = 1598.012570136
            xmax = 1608.19033253
            text = ""
        intervals [442]:
            xmin = 1608.19033253
            xmax = 1608.773398578
            text = "Yeah."
        intervals [443]:
            xmin = 1608.773398578
            xmax = 1616.145596332
            text = ""
        intervals [444]:
            xmin = 1616.145596332
            xmax = 1621.577752807
            text = "No, I mean, yeah, I wanted to get into it for a while, but then I didn't."
        intervals [445]:
            xmin = 1621.577752807
            xmax = 1626.401228906
            text = ""
        intervals [446]:
            xmin = 1626.401228906
            xmax = 1632.401768727
            text = "I think I think it's because it was sort of the first thing ever. Like same with Harry Potter."
        intervals [447]:
            xmin = 1632.401768727
            xmax = 1632.441127056
            text = ""
        intervals [448]:
            xmin = 1632.441127056
            xmax = 1637.634999507
            text = "I feel like um cause there have been a few different magical school things that I've read."
        intervals [449]:
            xmin = 1637.634999507
            xmax = 1637.735836067
            text = ""
        intervals [450]:
            xmin = 1637.735836067
            xmax = 1644.344464868
            text = "I mean, watched um and they're a bit less popular like Little Witch Academia. But it's a anime."
        intervals [451]:
            xmin = 1644.344464868
            xmax = 1644.600721164
            text = ""
        intervals [452]:
            xmin = 1644.600721164
            xmax = 1650.191997987
            text = "Um that was very well executed, I would say. Um it's it was a bit."
        intervals [453]:
            xmin = 1650.191997987
            xmax = 1650.708095303
            text = ""
        intervals [454]:
            xmin = 1650.708095303
            xmax = 1657.109639915
            text = "The anot- the magic is very uncreative, but that doesn't really matter, because they used it more for a visual aspect."
